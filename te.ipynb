   "source": [
    "a = int(input())\n",
    "\n",
    "for i in range(1, a+1):\n",
    "    if i > 1:\n",
    "        print(\", \", end=\"\")\n",
    "\n",
    "    if i % 3 == 0:\n",
    "        print(\"@\", end=\"\")\n",
    "    elif i % 3 == 1:\n",
    "        print(\"1\", end=\"\")\n",
    "    else:\n",
    "        print(\"A\", end=\"\")"
   ],
